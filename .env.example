# ---------------------------------------------------------------------------
# Clerk — authentication (https://dashboard.clerk.com)
# Create an application, enable Google as a social connection, then copy the
# Publishable Key and Secret Key from API keys.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret shown when you add the webhook endpoint (Webhooks → your endpoint)
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional: Clerk reads these to build sign-in redirects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------------------
# Supabase — Postgres database and private document storage
# Project Settings → API: Project URL, service_role key.
# The service role key is server-only. Never prefix it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Secret key (sb_secret_…) or legacy service_role JWT. SUPABASE_SECRET_KEY is also
# accepted as an alias, but only one of the two is needed.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend — notification email (https://resend.com/api-keys)
# Until a sending domain is verified, keep the default onboarding@resend.dev
# sender; it can deliver to the account owner's address only.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_EMAIL=sanjanareddy2607@gmail.com
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Application
# Public origin of the deployment, used for absolute links in notifications.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk user id of the owner (user_...). Copy it from the admin page or the
# Clerk dashboard after the first sign-in. Empty means nobody is an admin.
ADMIN_CLERK_USER_ID=
